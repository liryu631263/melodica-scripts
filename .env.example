# 复制本文件为 .env 并填入对应厂商的 API Key（.env 已被 .gitignore 忽略，不会提交）

# 视觉模型厂商：glm（默认）/ deepseek / qwen
VL_PROVIDER=glm

# ---- GLM（智谱 bigmodel）----
# 在 https://open.bigmodel.cn 控制台复制完整的「API Key」（形如 xxxxxxxx.yyyy…，含中间的 .）
GLM_API_KEY=
# 可选：覆盖默认模型 / 接口地址
# GLM_MODEL=glm-5.3-flash
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM 推理力度：low（快，读谱推荐）/ high / max（最慢最准）。glm-5.3 强制思考，不支持关闭
GLM_REASONING=low

# ---- DeepSeek ----
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Qwen（阿里百炼）----
# DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen3-vl-plus
# QWEN_BASE_URL=https://llm-n2tr15mt28kgsvtu.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
